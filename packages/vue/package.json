{
  "name": "@moderno-ui/vue",
  "version": "0.2.0",
  "description": "Moderno styled components for Vue (Zag.js behavior core + Moderno tokens).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anothernocoder/moderno.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-styles.mjs",
    "check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@moderno-ui/chart-core": "workspace:*",
    "@moderno-ui/class-contract": "workspace:*",
    "@moderno-ui/styles": "workspace:*",
    "@moderno-ui/tokens": "workspace:*",
    "@zag-js/accordion": "^1.0.0",
    "@zag-js/carousel": "^1.0.0",
    "@zag-js/checkbox": "^1.0.0",
    "@zag-js/combobox": "^1.0.0",
    "@zag-js/date-picker": "^1.0.0",
    "@zag-js/dialog": "^1.0.0",
    "@zag-js/menu": "^1.0.0",
    "@zag-js/number-input": "^1.0.0",
    "@zag-js/pagination": "^1.0.0",
    "@zag-js/popover": "^1.0.0",
    "@zag-js/progress": "^1.0.0",
    "@zag-js/radio-group": "^1.0.0",
    "@zag-js/select": "^1.0.0",
    "@zag-js/slider": "^1.0.0",
    "@zag-js/splitter": "^1.0.0",
    "@zag-js/switch": "^1.0.0",
    "@zag-js/tabs": "^1.0.0",
    "@zag-js/toast": "^1.0.0",
    "@zag-js/tooltip": "^1.0.0",
    "@zag-js/vue": "^1.0.0"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "jsdom": "^29.1.1",
    "vite": "^5.4.20",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5"
  }
}
