{
  "name": "moderno",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Moderno — framework-agnostic, token-driven design system (React, Vue, Svelte, Solid)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "turbo run check",
    "docs": "pnpm --filter @moderno-ui/docs dev",
    "smoke-test": "node --test scripts/pack-smoke-test.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.30.3"
}
